  <Flow>
    <Routine name="Instructions"/>
    <LoopInitiator loopType="TrialHandler" name="practiceTrials">
      <Param name="Selected rows" updates="None" val="[0, 1]" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(1)), ('gapType', 'short'), ('probeRelation', 'related'), ('probePresent', np.int64(0)), ('probeWord', 'SLEEP'), ('firstTarget', 'COIN'), ('secondTarget', 'GATE'), ('secondIndex', np.int64(5)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|GATE|FAN|BOOK|DESK|LAMP|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(2)), ('gapType', 'short'), ('probeRelation', 'related'), ('probePresent', np.int64(1)), ('probeWord', 'SLEEP'), ('firstTarget', 'COIN'), ('secondTarget', 'SLEEP'), ('secondIndex', np.int64(5)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|SLEEP|FAN|BOOK|DESK|LAMP|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(3)), ('gapType', 'short'), ('probeRelation', 'unrelated'), ('probePresent', np.int64(0)), ('probeWord', 'BRICK'), ('firstTarget', 'COIN'), ('secondTarget', 'GATE'), ('secondIndex', np.int64(5)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|GATE|FAN|BOOK|DESK|LAMP|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(4)), ('gapType', 'short'), ('probeRelation', 'unrelated'), ('probePresent', np.int64(1)), ('probeWord', 'BRICK'), ('firstTarget', 'COIN'), ('secondTarget', 'BRICK'), ('secondIndex', np.int64(5)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|BRICK|FAN|BOOK|DESK|LAMP|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(5)), ('gapType', 'long'), ('probeRelation', 'related'), ('probePresent', np.int64(0)), ('probeWord', 'SLEEP'), ('firstTarget', 'COIN'), ('secondTarget', 'GATE'), ('secondIndex', np.int64(9)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|ROPE|FAN|BOOK|DESK|GATE|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(6)), ('gapType', 'long'), ('probeRelation', 'related'), ('probePresent', np.int64(1)), ('probeWord', 'SLEEP'), ('firstTarget', 'COIN'), ('secondTarget', 'SLEEP'), ('secondIndex', np.int64(9)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|ROPE|FAN|BOOK|DESK|SLEEP|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(7)), ('gapType', 'long'), ('probeRelation', 'unrelated'), ('probePresent', np.int64(0)), ('probeWord', 'BRICK'), ('firstTarget', 'COIN'), ('secondTarget', 'GATE'), ('secondIndex', np.int64(9)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|ROPE|FAN|BOOK|DESK|GATE|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')]), OrderedDict([('phase', 'practice'), ('version', 'practice'), ('itemID', np.int64(8)), ('gapType', 'long'), ('probeRelation', 'unrelated'), ('probePresent', np.int64(1)), ('probeWord', 'BRICK'), ('firstTarget', 'COIN'), ('secondTarget', 'BRICK'), ('secondIndex', np.int64(9)), ('streamItems', 'LEAF|CUP|COIN|MAP|HILL|ROPE|FAN|BOOK|DESK|BRICK|FORK|KEY'), ('cue1', 'bed'), ('cue2', 'pillow'), ('cue3', 'dream'), ('cue4', 'tired'), ('cue5', 'rest')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="practice_with_cues.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="practiceTrials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
