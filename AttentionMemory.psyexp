        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="First, you will read a short list of words.&amp;#10;&amp;#10;Then, words will flash one at a time. Watch for TWO BLUE words.&amp;#10;&amp;#10;After each stream, you will answer two questions.&amp;#10;First, enter the first blue word you saw.&amp;#10;Then, decide whether a word we show you was the second blue word.&amp;#10;&amp;#10;Press SPACE to begin." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
